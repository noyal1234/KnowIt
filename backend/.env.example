ENV=development
AUTH_PROVIDER=local
PIPELINE_PHASE=build

# Supabase (prod — optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Groq models — tiered for cost vs quality (build phase)
# Stage 1: fast parse (8B) | Stage 2: regulatory enrich (70B) | Stage 3: grounded report (8B)
MODEL_STAGE0=openfoodfacts/spellcheck-mistral-7b
MODEL_STAGE1=llama-3.1-8b-instant
MODEL_STAGE2_ASSIST=foodyllm
MODEL_STAGE2=llama-3.3-70b-versatile
MODEL_STAGE3=llama-3.1-8b-instant

# Providers — Groq + Tavily + Tesseract (free OCR); leave fallbacks empty unless keys are set
PROVIDER_LLM=groq
PROVIDER_LLM_FALLBACK=
PROVIDER_LLM_STAGE0=ollama
PROVIDER_LLM_STAGE2_ASSIST=huggingface_local
PROVIDER_OCR=tesseract
PROVIDER_OCR_FALLBACK=
PROVIDER_SEARCH=tavily
PROVIDER_SEARCH_FALLBACK=
PROVIDER_STORAGE=local

# Tavily budget per scan (Stage 3 only, flagged ingredients)
SEARCH_MAX_QUERIES=5
SEARCH_MAX_RESULTS_PER_QUERY=2

OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
GOOGLE_VISION_CREDENTIALS=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_review
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=30

LOCAL_STORAGE_PATH=./storage
RATE_LIMIT_PER_MINUTE=60
